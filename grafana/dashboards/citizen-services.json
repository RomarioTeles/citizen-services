{
  "title": "Citizen Services",
  "uid": "citizen-services",
  "schemaVersion": 38,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Serviços Cadastrados",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(citizen_services_registrations_total[$__range])",
          "legendFormat": "cadastros"
        }
      ]
    },
    {
      "id": 2,
      "title": "Consultas por ID",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(citizen_services_consulted_total[$__range])",
          "legendFormat": "consultas"
        }
      ]
    },
    {
      "id": 3,
      "title": "Consultas Não Encontradas",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(citizen_services_not_found_total[$__range])",
          "legendFormat": "não encontrados"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memória JVM Utilizada (heap)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{ id }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 5,
      "title": "Requisições HTTP por Endpoint",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count[1m])",
          "legendFormat": "{{ method }} {{ uri }} {{ status }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "title": "Conexões HikariCP",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_active",
          "legendFormat": "ativas"
        },
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_idle",
          "legendFormat": "ociosas"
        }
      ]
    },
    {
      "id": 7,
      "title": "Threads JVM",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "jvm_threads_live_threads",
          "legendFormat": "live"
        },
        {
          "datasource": "Prometheus",
          "expr": "jvm_threads_daemon_threads",
          "legendFormat": "daemon"
        }
      ]
    }
  ]
}
