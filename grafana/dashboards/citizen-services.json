{
  "title": "Citizen Services",
  "uid": "citizen-services",
  "schemaVersion": 38,
  "refresh": "15s",
  "panels": [
    {
      "id": 8,
      "title": "Request Rate",
      "type": "stat",
      "description": "Quantidade de requisições HTTP por segundo recebidas pela aplicação.",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 9,
      "title": "Error Rate",
      "type": "stat",
      "description": "Percentual de requisições que terminaram com HTTP 5xx. Não considera 4xx como erro da aplicação.",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(100 * sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))) or on() vector(0)",
          "legendFormat": "5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 10,
      "title": "Latência média",
      "type": "stat",
      "description": "Tempo médio de resposta das requisições HTTP nos últimos 5 minutos.",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(1000 * sum(rate(http_server_requests_seconds_sum[5m])) / sum(rate(http_server_requests_seconds_count[5m]))) or on() vector(0)",
          "legendFormat": "ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 1,
      "title": "Serviços Cadastrados",
      "type": "stat",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "floor(increase(citizen_services_registrations_total[$__range]))",
          "legendFormat": "cadastros"
        }
      ]
    },
    {
      "id": 2,
      "title": "Consultas por ID",
      "type": "stat",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "floor(increase(citizen_services_consulted_total[$__range]))",
          "legendFormat": "consultas"
        }
      ]
    },
    {
      "id": 3,
      "title": "Consultas Não Encontradas",
      "type": "stat",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "floor(increase(citizen_services_not_found_total[$__range]))",
          "legendFormat": "não encontrados"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memória JVM Utilizada (heap)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{ id }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 5,
      "title": "Requisições HTTP por Endpoint",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count[1m])",
          "legendFormat": "{{ method }} {{ uri }} {{ status }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "title": "Conexões HikariCP",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_active",
          "legendFormat": "ativas"
        },
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_idle",
          "legendFormat": "ociosas"
        }
      ]
    },
    {
      "id": 7,
      "title": "Threads JVM",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "jvm_threads_live_threads",
          "legendFormat": "live"
        },
        {
          "datasource": "Prometheus",
          "expr": "jvm_threads_daemon_threads",
          "legendFormat": "daemon"
        }
      ]
    }
  ]
}
